+// Only known constructors are callable. Unknown globals/methods remain nil so the
+// validation VM still reports missing APIs instead of swallowing arbitrary calls.
+int ConfigurationConstructor(lua_State* L) {
+    StubFunction(L);
+    if (lua_gettop(L) >= 2 && !lua_isnil(L, 2)) {
+        luaL_checktype(L, 2, LUA_TTABLE);
+        lua_pushvalue(L, 2);
+    } else {
+        lua_newtable(L);
+    }
+    lua_newtable(L);
+    lua_pushvalue(L, 1);
+    lua_setfield(L, -2, "__index");
+    lua_setmetatable(L, -2);
+    return 1;
+}
+
+int ArchiveDoFile(lua_State* L) {
+    const char* requested = luaL_checkstring(L, 1);
+    lua_settop(L, 1);
+    auto* archive = static_cast<const Psarc*>(lua_touserdata(L, lua_upvalueindex(1)));
+    int status = LUA_ERRFILE;
+    // Destroy C++ strings/buffers before any Lua longjmp (lua_error/lua_call).
+    {
+        const std::string path = Vfs::ToArchivePath(requested);
+        const auto part = std::filesystem::path(path);
+        bool invalid = path.empty() || part.is_absolute();
+        for (const auto& component : part) invalid |= component == "..";
+        auto code = invalid ? std::nullopt : archive->Read(path);
+        if (!code) {
+            lua_pushfstring(L, "archive script unavailable: %s", requested);
+        } else {
+            if (fox::IsWrapped(*code)) *code = fox::Unwrap(*code);
+            const std::string chunk = "@" + path;
+            status = luaL_loadbuffer(L, reinterpret_cast<const char*>(code->data()), code->size(), chunk.c_str());
+        }
+    }
+    if (status != 0) return lua_error(L);
+    lua_call(L, 0, LUA_MULTRET);
+    return lua_gettop(L) - 1;
+}
+
+void RegisterConfigurationConstructor(lua_State* L, const char* name) {
+    lua_getglobal(L, name);
+    if (!lua_istable(L, -1)) {
+        lua_pop(L, 1);
+        lua_newtable(L);
+        lua_pushvalue(L, -1);
+        lua_setglobal(L, name);
+    }
+    lua_newtable(L);
+    lua_pushstring(L, name);
+    lua_pushliteral(L, "new");
+    lua_pushcclosure(L, ConfigurationConstructor, 2);
+    lua_setfield(L, -2, "__call");
+    lua_setmetatable(L, -2);
+    lua_pop(L, 1);
+}
+
 }
 
