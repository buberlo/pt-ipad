diff --git a/tests/script_api_test.cpp b/tests/script_api_test.cpp
new file mode 100644
index 0000000..3df92ce
--- /dev/null
+++ b/tests/script_api_test.cpp
@@ -0,0 +1,102 @@
+#include <cstdio>
+#include <string_view>
+#include "engine/script/lua_vm.h"
+#include "engine/fs/psarc.h"
+#include "game/script_api.h"
+#include "game/script_property.h"
+#include "game/lua_entity.h"
+#include "game/stage_manager.h"
+
+namespace {
+int failures = 0;
+void Check(bool value, const char* label) {
+    std::printf("%s %s\n", value ? "PASS" : "FAIL", label);
+    failures += !value;
+}
+bool Run(pt::LuaVm& vm, std::string_view source) {
+    return vm.RunChunk("synthetic", {reinterpret_cast<const uint8_t*>(source.data()), source.size()});
+}
+}
+
+int main() {
+    pt::LuaVm vm;
+    pt::game::RegisterStubApi(vm);
+    Check(Run(vm, R"(
+        local config = { pluginName = 'synthetic', priority = 12, isActive = false }
+        local p = GrPluginDepthOfField(config)
+        assert(p == config and p.priority == 12 and p.isActive == false)
+        GrRenderPlugin.AddPlugin(p)
+        GrTools.SetLodFactorResolution(100, 80)
+        SubtitlesCommand:SetDefaultSubPriority(1, 2, 3)
+        local app = Application{ name = 'test' }
+        local editor = Editor{ name = 'editor' }
+        app:AddGame(editor)
+        app:SetMainGame(editor)
+        local scene = editor:CreateScene('scene')
+        local bucket = editor:CreateBucket('bucket', scene)
+        assert(type(scene) == 'table' and type(bucket) == 'table')
+        editor:SetMainBucket(bucket)
+        editor:Setup()
+        local u = UiDaemon.GetInstance()
+        assert(u == UiDaemon.GetInstance())
+        u.ResetDefaultButtonMap()
+        u.SetButtonMap('test', fox.PAD_U + 4)
+        u.CreateButtonMap()
+        assert(type(fox.PAD_A) == 'number')
+        assert(UnknownPlugin == nil and GrTools.UnknownMethod == nil)
+        assert(not pcall(function() GrTools.UnknownMethod() end))
+        assert(not pcall(function() GrPluginDepthOfField(3) end))
+    )"), "explicit boot configuration adapters preserve inputs and fail on unknown APIs");
+    Check(Run(vm, "Editor = { Setting = function() return 42 end }"), "class script replaces table");
+    pt::game::RegisterStubApi(vm);
+    Check(Run(vm, "local e=Editor{}; assert(e:Setting()==42 and type(e:CreateScene('s'))=='table')"),
+          "refresh restores constructors and missing APIs while preserving Lua methods");
+    pt::Psarc empty_archive;
+    pt::game::RegisterArchiveScriptLoader(vm, empty_archive);
+    Check(Run(vm, R"(
+        assert(not pcall(dofile, '../outside.lua'))
+        assert(not pcall(dofile, '/Assets/missing.lua'))
+        assert(not pcall(dofile, 'missing.lua'))
+    )"), "archive dofile fails closed without host file fallback");
+    bool logged = false;
+    for (const auto& call : pt::game::RecentStubCalls()) {
+        logged |= call.module == "GrPluginDepthOfField" && call.function == "new";
+    }
+    Check(logged, "configuration constructors are recorded as stubs");
+    Check(lua_gettop(vm.State()) == 0, "boot adapters leave the VM stack balanced");
+
+    pt::fox2::DataSetFile file;
+    pt::fox2::Entity e;
+    e.class_name = "GeoModuleCondition";
+    pt::fox2::Property legacy;
+    legacy.name = "modleData";
+    legacy.type = pt::fox2::DataType::EntityLink;
+    legacy.container = pt::fox2::Container::DynamicArray;
+    legacy.element_size = sizeof(pt::fox2::EntityLink);
+    e.dynamic_properties.push_back(legacy);
+    auto* resolved = pt::game::FindScriptProperty(file, e, "modelData");
+    Check(resolved == &e.dynamic_properties[0], "legacy light-condition model array is resolved");
+    pt::game::Stage stage;
+    Check(resolved && pt::game::PushProperty(vm.State(), stage, file, *resolved), "legacy empty array is pushable");
+    lua_setglobal(vm.State(), "models");
+    Check(Run(vm, "local n=0; for _ in pairs(models) do n=n+1 end; assert(n==0)"),
+          "empty legacy model array supports the trap's pairs loop");
+    e.dynamic_properties[0].payload.resize(sizeof(pt::fox2::EntityLink));
+    Check(pt::game::FindScriptProperty(file, e, "modelData")->Count() == 1,
+          "populated legacy payload is preserved");
+    pt::fox2::Property canonical = legacy;
+    canonical.name = "modelData";
+    e.dynamic_properties.push_back(canonical);
+    Check(pt::game::FindScriptProperty(file, e, "modelData") == &e.dynamic_properties[1], "canonical property wins");
+    e.dynamic_properties.pop_back();
+    e.class_name = "StaticModel";
+    Check(!pt::game::FindScriptProperty(file, e, "modelData"), "other classes are unchanged");
+    e.class_name = "GeoModuleCondition";
+    e.dynamic_properties[0].type = pt::fox2::DataType::String;
+    Check(!pt::game::FindScriptProperty(file, e, "modelData"), "malformed legacy type is not aliased");
+    e.dynamic_properties[0].type = pt::fox2::DataType::EntityLink;
+    e.dynamic_properties[0].container = pt::fox2::Container::StaticArray;
+    Check(!pt::game::FindScriptProperty(file, e, "modelData"), "malformed legacy container is not aliased");
+    Check(!pt::game::FindScriptProperty(file, e, "missingData"), "unrelated missing properties remain absent");
+    return failures ? 1 : 0;
+}
