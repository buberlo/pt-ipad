     canvas.scale = std::min(canvas.extent.x / kWidth, canvas.extent.y / kHeight);
     canvas.origin = (canvas.extent - glm::vec2(kWidth, kHeight) * canvas.scale) * 0.5f;
     return canvas;
+}
+
+bool UiCanvas::ToUnits(glm::vec2 target, glm::vec2& units) const {
+    if (!(scale > 0.0f) || !std::isfinite(target.x) || !std::isfinite(target.y)) return false;
+    const glm::vec2 px = (target - origin) / scale;
+    if (px.x < 0 || px.y < 0 || px.x >= kWidth || px.y >= kHeight) return false;
+    units = glm::vec2(px.x - kWidth * .5f, kHeight * .5f - px.y) / kUnit;
+    return true;
+}
+
+bool UiCanvas::MapDisplayPoint(glm::vec2 pixels, VkExtent2D display, VkExtent2D render, glm::vec2& out) {
+    if (!display.width || !display.height || !render.width || !render.height ||
+        !std::isfinite(pixels.x) || !std::isfinite(pixels.y)) return false;
+    // Match the integer shown extent and centered offset in Renderer::EndFrame.
+    const float fit = std::min(static_cast<float>(display.width) / render.width, static_cast<float>(display.height) / render.height);
+    const VkExtent2D shown{std::max(1u, static_cast<uint32_t>(render.width * fit)),
+                           std::max(1u, static_cast<uint32_t>(render.height * fit))};
+    const glm::vec2 offset((display.width - shown.width) / 2, (display.height - shown.height) / 2);
+    const glm::vec2 local = pixels - offset;
+    if (local.x < 0 || local.y < 0 || local.x >= shown.width || local.y >= shown.height) return false;
+    out = local * glm::vec2(static_cast<float>(render.width) / shown.width, static_cast<float>(render.height) / shown.height);
+    return true;
 }
 
