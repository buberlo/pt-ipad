new file mode 100644
index 0000000..1057246
--- /dev/null
+++ b/src/engine/platform/frame_mode.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <string_view>
+
+namespace pt {
+constexpr int ParseComparisonFrameLimit(std::string_view value) {
+    return value == "30" ? 30 : value == "60" ? 60 : 0;
+}
+constexpr int MobileFrameLimit(int saved) { return saved == 60 ? 60 : 30; }
+constexpr int EffectiveFrameLimit(int saved, int comparison_override) {
+    return comparison_override ? comparison_override : saved;
+}
+}
