diff --git a/tests/mobile_frame_mode_test.cpp b/tests/mobile_frame_mode_test.cpp
new file mode 100644
index 0000000..51156ac
--- /dev/null
+++ b/tests/mobile_frame_mode_test.cpp
@@ -0,0 +1,19 @@
+#include "engine/platform/frame_mode.h"
+#include "engine/platform/settings.h"
+#include <cassert>
+int main() {
+    for (auto value : {"", "0", "59", "120", "60hz", " 60", "60\n"})
+        assert(pt::ParseComparisonFrameLimit(value) == 0);
+    assert(pt::ParseComparisonFrameLimit("30") == 30);
+    assert(pt::ParseComparisonFrameLimit("60") == 60);
+    for (int saved : {0, 20, 30, 59, 60, 120})
+        assert(pt::MobileFrameLimit(saved) == (saved == 60 ? 60 : 30));
+    pt::AppSettings settings;
+    settings.display.fps_limit = 30;
+    assert(pt::EffectiveFrameLimit(settings.display.fps_limit, 60) == 60);
+    assert(settings.display.fps_limit == 30); // transient comparison never changes saved choices
+    settings.display.fps_limit = 60;
+    assert(pt::EffectiveFrameLimit(settings.display.fps_limit, 30) == 30);
+    assert(settings.display.fps_limit == 60);
+    assert(pt::EffectiveFrameLimit(60, 0) == 60);
+}
