diff --git a/cmake/Apple.cmake b/cmake/Apple.cmake
new file mode 100644
index 0000000..854e2c1
--- /dev/null
+++ b/cmake/Apple.cmake
@@ -0,0 +1,67 @@
+# Host shader tools are executable on the build Mac; Vulkan headers and MoltenVK
+# belong to the target. Never resolve host programs through an iOS sysroot.
+set(PT_DESKTOP_EXTRAS_DEFAULT ON)
+set(PT_SHADER_TARGET_ENV "vulkan1.3" CACHE STRING "SPIR-V target environment")
+set(PT_RESOURCE_OUTPUT_DIR "$<TARGET_FILE_DIR:pt>")
+if(NOT APPLE)
+  return()
+endif()
+enable_language(OBJC)
+set(PT_DESKTOP_EXTRAS_DEFAULT OFF)
+set(PT_BUNDLE_KEYWORD MACOSX_BUNDLE)
+set(PT_IOS OFF)
+set(PT_IOS_PLIST_VALUE false)
+if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+  set(PT_IOS ON)
+  set(PT_IOS_PLIST_VALUE true)
+endif()
+option(PT_NETWORK_UPDATES "Check upstream releases over the network" OFF)
+set(PT_BUNDLE_IDENTIFIER "com.konradkern.pt.native" CACHE STRING "Apple application bundle identifier")
+set(PT_DEVELOPMENT_TEAM "" CACHE STRING "Optional local Apple development team")
+set(PT_MOLTENVK_LIBRARY "" CACHE FILEPATH "Target MoltenVK static archive")
+set(PT_MOLTENVK_INCLUDE_DIR "" CACHE PATH "Target Vulkan headers directory")
+set(PT_MOLTENVK_LICENSE "" CACHE FILEPATH "License from the target MoltenVK source or package")
+set(PT_HOST_GLSLC "" CACHE FILEPATH "Host glslc shader compiler")
+if(NOT PT_HOST_GLSLC)
+  find_program(PT_GLSLC_FOUND glslc HINTS /opt/homebrew/bin /usr/local/bin NO_CMAKE_FIND_ROOT_PATH REQUIRED)
+  set(PT_HOST_GLSLC "${PT_GLSLC_FOUND}" CACHE FILEPATH "Host glslc shader compiler" FORCE)
+endif()
+set(Vulkan_GLSLC_EXECUTABLE "${PT_HOST_GLSLC}")
+if(NOT PT_MOLTENVK_INCLUDE_DIR)
+  find_path(PT_VULKAN_HEADERS_FOUND vulkan/vulkan.h HINTS /opt/homebrew/include /usr/local/include NO_CMAKE_FIND_ROOT_PATH REQUIRED)
+  set(PT_MOLTENVK_INCLUDE_DIR "${PT_VULKAN_HEADERS_FOUND}" CACHE PATH "Target Vulkan headers directory" FORCE)
+endif()
+if(NOT PT_MOLTENVK_LIBRARY AND NOT PT_IOS)
+  find_library(PT_MOLTENVK_FOUND NAMES libMoltenVK.a HINTS /opt/homebrew/lib /usr/local/lib NO_CMAKE_FIND_ROOT_PATH REQUIRED)
+  set(PT_MOLTENVK_LIBRARY "${PT_MOLTENVK_FOUND}" CACHE FILEPATH "Target MoltenVK static archive" FORCE)
+endif()
+if(NOT EXISTS "${PT_MOLTENVK_LIBRARY}")
+  message(FATAL_ERROR "Set PT_MOLTENVK_LIBRARY to the MoltenVK archive built for this Apple target")
+endif()
+if(NOT TARGET Vulkan::Headers)
+  add_library(Vulkan::Headers INTERFACE IMPORTED)
+  set_target_properties(Vulkan::Headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${PT_MOLTENVK_INCLUDE_DIR}")
+endif()
+file(SHA256 "${PT_MOLTENVK_LIBRARY}" PT_MOLTENVK_SHA256)
+file(WRITE "${CMAKE_BINARY_DIR}/apple-build-inputs.txt"
+  "system=${CMAKE_SYSTEM_NAME}\narchitecture=${CMAKE_OSX_ARCHITECTURES}\nsdk=${CMAKE_OSX_SYSROOT}\nminimum_os=${CMAKE_OSX_DEPLOYMENT_TARGET}\nmoltenvk_library=${PT_MOLTENVK_LIBRARY}\nmoltenvk_sha256=${PT_MOLTENVK_SHA256}\nvulkan_headers=${PT_MOLTENVK_INCLUDE_DIR}\nhost_glslc=${PT_HOST_GLSLC}\n")
+if(NOT PT_MOLTENVK_LICENSE AND NOT PT_IOS)
+  find_file(PT_MOLTENVK_LICENSE_FOUND LICENSE HINTS /opt/homebrew/opt/molten-vk /usr/local/opt/molten-vk NO_CMAKE_FIND_ROOT_PATH)
+  if(PT_MOLTENVK_LICENSE_FOUND)
+    set(PT_MOLTENVK_LICENSE "${PT_MOLTENVK_LICENSE_FOUND}" CACHE FILEPATH "License from target MoltenVK" FORCE)
+  endif()
+endif()
+add_library(PT_MoltenVK STATIC IMPORTED GLOBAL)
+set_target_properties(PT_MoltenVK PROPERTIES IMPORTED_LOCATION "${PT_MOLTENVK_LIBRARY}")
+set_property(TARGET PT_MoltenVK PROPERTY INTERFACE_LINK_LIBRARIES
+  "-framework Metal;-framework QuartzCore;-framework Foundation;-framework IOSurface;-framework IOKit;-framework CoreGraphics")
+if(PT_IOS)
+  set_property(TARGET PT_MoltenVK APPEND PROPERTY INTERFACE_LINK_LIBRARIES "-framework UIKit")
+else()
+  set_property(TARGET PT_MoltenVK APPEND PROPERTY INTERFACE_LINK_LIBRARIES "-framework AppKit")
+endif()
+if(PT_IOS)
+  set(PT_RESOURCE_OUTPUT_DIR "$<TARGET_BUNDLE_DIR:pt>")
+else()
+  set(PT_RESOURCE_OUTPUT_DIR "$<TARGET_BUNDLE_CONTENT_DIR:pt>/Resources")
+endif()
diff --git a/cmake/AppleBundle.cmake b/cmake/AppleBundle.cmake
new file mode 100644
index 0000000..44e8afc
--- /dev/null
+++ b/cmake/AppleBundle.cmake
@@ -0,0 +1,65 @@
+foreach(game pt pt_release)
+  set_target_properties(${game} PROPERTIES MACOSX_BUNDLE TRUE
+    MACOSX_BUNDLE_GUI_IDENTIFIER "${PT_BUNDLE_IDENTIFIER}"
+    MACOSX_BUNDLE_BUNDLE_NAME "P.T. Native"
+    MACOSX_BUNDLE_SHORT_VERSION_STRING "${PT_VERSION}"
+    MACOSX_BUNDLE_BUNDLE_VERSION "1"
+    MACOSX_BUNDLE_INFO_PLIST "${CMAKE_SOURCE_DIR}/cmake/Info.plist.in"
+    XCODE_ATTRIBUTE_CODE_SIGN_STYLE Automatic
+    XCODE_ATTRIBUTE_DEVELOPMENT_TEAM "${PT_DEVELOPMENT_TEAM}"
+    XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "2")
+  if(PT_IOS)
+    set(resources "$<TARGET_BUNDLE_DIR:${game}>")
+  else()
+    set(resources "$<TARGET_BUNDLE_CONTENT_DIR:${game}>/Resources")
+  endif()
+  add_dependencies(${game} pt_shaders)
+  add_custom_command(TARGET ${game} POST_BUILD
+    COMMAND ${CMAKE_COMMAND} -E copy_directory "${PT_SPIRV_DIR}" "${resources}/shaders"
+    COMMAND ${CMAKE_COMMAND} -E copy_directory "${PT_VOICE_DIR}" "${resources}/voice"
+    COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_SOURCE_DIR}/assets/fonts" "${resources}/fonts"
+    COMMAND ${CMAKE_COMMAND} -E make_directory "${resources}/licenses"
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_SOURCE_DIR}/LICENSE" "${resources}/licenses/pt-pc-MIT.txt"
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${PT_WWISE_CODEBOOKS_LICENSE}" "${resources}/licenses/ww2ogg-COPYING"
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_BINARY_DIR}/apple-build-inputs.txt" "${resources}/apple-build-inputs.txt"
+    VERBATIM)
+  foreach(dep sdl3 zlib whisper volk vma glm imgui stb lua51 bc7enc harfbuzz ogg vorbis)
+    file(GLOB notices "${${dep}_SOURCE_DIR}/LICENSE*" "${${dep}_SOURCE_DIR}/COPYING*" "${${dep}_SOURCE_DIR}/COPYRIGHT*")
+    foreach(notice IN LISTS notices)
+      if(NOT IS_DIRECTORY "${notice}")
+        get_filename_component(notice_name "${notice}" NAME)
+        add_custom_command(TARGET ${game} POST_BUILD
+          COMMAND ${CMAKE_COMMAND} -E copy_if_different "${notice}" "${resources}/licenses/${dep}-${notice_name}" VERBATIM)
+      endif()
+    endforeach()
+  endforeach()
+  if(EXISTS "${whisper_SOURCE_DIR}/ggml/LICENSE")
+    add_custom_command(TARGET ${game} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
+      "${whisper_SOURCE_DIR}/ggml/LICENSE" "${resources}/licenses/ggml-LICENSE" VERBATIM)
+  endif()
+  if(EXISTS "${PT_MOLTENVK_LICENSE}")
+    add_custom_command(TARGET ${game} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
+      "${PT_MOLTENVK_LICENSE}" "${resources}/licenses/MoltenVK-LICENSE" VERBATIM)
+    get_filename_component(molten_source "${PT_MOLTENVK_LICENSE}" DIRECTORY)
+    foreach(component SPIRV-Cross SPIRV-Tools cereal Vulkan-Headers Volk)
+      file(GLOB molten_notices "${molten_source}/External/${component}/LICENSE*"
+           "${molten_source}/External/${component}/COPYING*"
+           "${molten_source}/External/${component}/COPYRIGHT*")
+      foreach(notice IN LISTS molten_notices)
+        if(NOT IS_DIRECTORY "${notice}")
+          get_filename_component(notice_name "${notice}" NAME)
+          add_custom_command(TARGET ${game} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${notice}" "${resources}/licenses/MoltenVK-${component}-${notice_name}" VERBATIM)
+        endif()
+      endforeach()
+    endforeach()
+    foreach(notice "cereal/include/cereal/external/LICENSE" "cereal/include/cereal/external/rapidjson/LICENSE"
+                   "cereal/include/cereal/external/rapidjson/msinttypes/LICENSE" "SPIRV-Tools/external/spirv-headers/LICENSE")
+      if(EXISTS "${molten_source}/External/${notice}")
+        string(REPLACE "/" "-" notice_name "${notice}")
+        add_custom_command(TARGET ${game} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
+          "${molten_source}/External/${notice}" "${resources}/licenses/MoltenVK-${notice_name}" VERBATIM)
+      endif()
+    endforeach()
+  endif()
+endforeach()
