--- /dev/null
+++ b/src/engine/platform/apple_host.m
@@ -0,0 +1,19 @@
+#include "engine/platform/apple_host.h"
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+#import <UIKit/UIKit.h>
+#import <Foundation/Foundation.h>
+
+bool pt_apple_is_active(void) {
+    if ([NSThread isMainThread]) {
+        return [UIApplication sharedApplication].applicationState == UIApplicationStateActive;
+    }
+    __block bool active = false;
+    dispatch_sync(dispatch_get_main_queue(), ^{
+        active = [UIApplication sharedApplication].applicationState == UIApplicationStateActive;
+    });
+    return active;
+}
+#else
+bool pt_apple_is_active(void) { return true; }
+#endif
