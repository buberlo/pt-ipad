+
+namespace fs = std::filesystem;
+using namespace pt::assets;
+namespace {
+// Digests independently generated with Python hashlib, including a multi-block stream.
+constexpr AssetSpec fixture[] = {
+    {"chunk1.psarc", 3, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", true},
+    {"texture.qar", 262163, "ba158e343d6f23c84d5eb7c5ebaccf62da47e6d06c928925c11f1228194872b2", true},
+    {"pathid_list_ps4.bin", 8, "ec91fdd9256cb75ae611249b50cb7eb16533f0fa91b86239ec1d439a1ea033b8", false},
+};
+void Expect(bool value, std::string_view message) { if (!value) throw std::runtime_error(std::string(message)); }
+void Write(const fs::path& path, std::string_view contents) {
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    file.write(contents.data(), static_cast<std::streamsize>(contents.size()));
+    if (!file) throw std::runtime_error("fixture write failed");
+}
+std::string Read(const fs::path& path) {
+    std::ifstream file(path, std::ios::binary);
+    return {std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+}
+std::string Manifest(bool optional = true) {
+    std::string text = R"({"schema":"pt-ipad-assets-v1","source_package":{"sfo":{"TITLE_ID":"CUSA01127"}},"assets":{)";
+    for (size_t i = 0; i < (optional ? 3 : 2); ++i) {
+        if (i) text += ',';
+        const auto& asset = fixture[i];
+        text += '"' + std::string(asset.name) + R"(":{"bytes":)" + std::to_string(asset.bytes) + R"(,"sha256":")" + std::string(asset.sha256) + R"(","matches_known_us_data":true})";
+    }
+    return text + "}}";
+}
+void Assets(const fs::path& directory, bool optional = true) {
+    fs::create_directory(directory);
+    Write(directory / "chunk1.psarc", "abc");
+    Write(directory / "texture.qar", std::string(fixture[1].bytes, 'x'));
+    if (optional) Write(directory / "pathid_list_ps4.bin", "optional");
+    Write(directory / "import-manifest.json", Manifest(optional));
+}
+struct Temp {
+    fs::path root;
+    Temp() {
+        auto candidate = fs::temp_directory_path() / "pt-asset-install-test-XXXXXX";
+        std::string text = candidate.string();
+        if (!mkdtemp(text.data())) throw std::runtime_error("mkdtemp failed");
+        root = text;
+        fs::create_directory(root / "saves");
+        Write(root / "saves/keep.bin", "save unchanged");
+    }
+    ~Temp() { std::error_code error; fs::remove_all(root, error); }
+    void SavesIntact() { Expect(Read(root / "saves/keep.bin") == "save unchanged", "save directory modified"); }
+};
+void Replace(std::string& text, std::string_view before, std::string_view after) {
+    auto at = text.find(before);
+    Expect(at != std::string::npos, "missing fixture substring");
+    text.replace(at, before.size(), after);
+}
+int cases = 0;
+template<class F> void Test(const char* name, F fn) {
+    fn(); ++cases; std::cout << "PASS " << name << '\n';
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+        if (argc == 2) {
