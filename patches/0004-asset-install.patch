+
+namespace pt::assets {
+enum class InstallStatus { Ready, Activated, Missing, Invalid, Cancelled, Busy, IoError, Unsupported };
+enum class InstallPhase { Verifying, BeforeActivation, AfterExchange, RollingBack };
+struct InstallProgress {
+    InstallPhase phase;
+    std::string_view file;
+    uint64_t completed = 0;
+    uint64_t total = 0;
+};
+struct InstallCallbacks {
+    // Called on the invoking thread. Return quickly; callbacks must not change installation files.
+    std::function<bool()> cancelled;
+    std::function<void(const InstallProgress&)> progress;
+};
+struct InstallResult {
+    InstallStatus status = InstallStatus::Invalid;
+    std::filesystem::path directory;
+    std::string message;
+    bool staging_rejected = false;
+    bool ready() const { return status == InstallStatus::Ready || status == InstallStatus::Activated; }
+};
+struct AssetSpec {
+    std::string_view name;
+    uint64_t bytes;
+    std::string_view sha256;
+    bool required;
+};
+std::span<const AssetSpec> KnownUsAssets();
+
+// Run on a worker while UIKit continues pumping events. Every call hashes the files;
+// editable manifests and metadata-only caches never establish content authenticity.
+// The OS-provided Documents root is trusted; children must be regular files with a single link.
+// A verified incoming directory is atomically installed. On replacement the prior
+// directory is retained as CUSA01127.previous. Saves outside these directories are untouched.
+InstallResult PrepareUsInstallation(const std::filesystem::path& documents,
+                                    const InstallCallbacks& callbacks = {});
+
+// Generic catalogue entry points support small synthetic host fixtures and read-only
+// verification. Production launch uses PrepareUsInstallation's compiled catalogue.
+InstallResult PrepareInstallation(const std::filesystem::path& documents,
+                                  std::span<const AssetSpec> catalogue,
+                                  const InstallCallbacks& callbacks = {});
+InstallResult VerifyInstallation(const std::filesystem::path& directory,
+                                 std::span<const AssetSpec> catalogue,
+                                 const InstallCallbacks& callbacks = {});
+} // namespace pt::assets
