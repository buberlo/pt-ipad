+            t.SavesIntact();
+        });
+        Test("manifest and streaming hashes including optional path list", [] {
+            Temp t; Assets(t.root / "CUSA01127");
+            int chunks = 0;
+            InstallCallbacks cb; cb.progress = [&](const auto& p) { if (p.file == "texture.qar" && p.completed) ++chunks; };
+            Expect(PrepareInstallation(t.root, fixture, cb).ready(), "valid installation rejected");
+            Expect(chunks == 2, "large file did not stream in bounded chunks");
+            Expect(VerifyInstallation(t.root / "CUSA01127", KnownUsAssets()).status == InstallStatus::Invalid, "synthetic files accepted as US assets");
+            t.SavesIntact();
