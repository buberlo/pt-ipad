+        Test("bad incoming leaves verified current playable", [] {
+            Temp t; Assets(t.root / "CUSA01127"); Assets(t.root / "CUSA01127.incoming");
+            Write(t.root / "CUSA01127.incoming/chunk1.psarc", "xyz");
+            auto result = PrepareInstallation(t.root, fixture);
+            Expect(result.status == InstallStatus::Ready && result.staging_rejected, "valid current installation not retained");
+            Expect(Read(t.root / "CUSA01127/chunk1.psarc") == "abc", "bad incoming replaced current");
+        });
+        Test("malformed manifest matrix", [] {
+            Temp t; Assets(t.root / "CUSA01127");
