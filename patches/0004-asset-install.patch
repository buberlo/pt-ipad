+            fs::remove(t.root / "CUSA01127/chunk1.psarc");
+            Expect(PrepareInstallation(t.root, fixture).status == InstallStatus::Invalid, "missing required file accepted");
+        });
+        Test("unexpected files and saves cannot be displaced", [] {
