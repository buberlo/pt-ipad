+            Expect(PrepareInstallation(t.root, fixture).status == InstallStatus::Activated, "replacement failed");
+            Expect(Read(t.root / "CUSA01127/source.txt") == "next", "new installation not active");
+            Expect(Read(t.root / "CUSA01127.previous/source.txt") == "previous", "previous installation lost");
