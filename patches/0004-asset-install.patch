+
+namespace pt::assets {
+namespace {
+constexpr AssetSpec known[] = {
+    {"chunk1.psarc", 421978112, "f3cf67ef215065df01619fb0b3fd03fba7f465752ac4107e485dd0ea9dda41ef", true},
+    {"texture.qar", 892291044, "436bb79d9d47df685423a9afaed89a8be5e88a938347dd18e63e94398c6ed9b0", true},
+    {"pathid_list_ps4.bin", 93248, "6b4641bafe18f785229500454c5d44cba04cc1302fd8e187c53047a04d2633d0", false},
+};
+#if defined(__APPLE__)
+constexpr const char* manifest_name = "import-manifest.json";
+constexpr const char* current_name = "CUSA01127";
+constexpr const char* incoming_name = "CUSA01127.incoming";
+constexpr const char* previous_name = "CUSA01127.previous";
+constexpr uint64_t max_manifest = 1024 * 1024;
+struct Failure { InstallStatus status; std::string message; };
+[[noreturn]] void Invalid(std::string message) { throw Failure{InstallStatus::Invalid, std::move(message)}; }
+[[noreturn]] void Io(std::string_view operation) {
+    throw Failure{InstallStatus::IoError, std::string(operation) + ": " + std::strerror(errno)};
+}
+struct Fd {
+    int value = -1;
+    explicit Fd(int fd = -1) : value(fd) {}
+    ~Fd() { if (value >= 0) close(value); }
+    Fd(const Fd&) = delete;
+    Fd& operator=(const Fd&) = delete;
+    Fd(Fd&& other) noexcept : value(other.value) { other.value = -1; }
+};
+bool Cancelled(const InstallCallbacks& cb) {
+    try { return cb.cancelled && cb.cancelled(); }
+    catch (...) { return true; }
+}
+void CheckCancel(const InstallCallbacks& cb) {
+    if (Cancelled(cb)) throw Failure{InstallStatus::Cancelled, "Installation cancelled; existing assets were preserved"};
+}
+void Progress(const InstallCallbacks& cb, InstallPhase phase, std::string_view name = {}, uint64_t done = 0, uint64_t total = 0) {
+    try { if (cb.progress) cb.progress({phase, name, done, total}); }
+    catch (...) { throw Failure{InstallStatus::Cancelled, "Installation callback stopped the operation"}; }
+    CheckCancel(cb);
+}
+bool SafeName(std::string_view name) {
+    return !name.empty() && name != "." && name != ".." && name.find_first_of("/\\:\0", 0, 4) == std::string_view::npos;
+}
+bool Digest(std::string_view text) {
+    if (text.size() != 64) return false;
+    for (char c : text) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+    return true;
+}
+void ValidateCatalogue(std::span<const AssetSpec> catalogue) {
+    if (catalogue.empty() || catalogue.size() > 32) Invalid("Invalid asset catalogue");
+    std::set<std::string_view> names;
+    for (const auto& asset : catalogue) {
+        if (!SafeName(asset.name) || asset.name == manifest_name || asset.name == "source.txt" ||
+            !Digest(asset.sha256) || !names.insert(asset.name).second) Invalid("Invalid asset catalogue entry");
+    }
+}
+
+// Bounded JSON reader: duplicate keys, invalid escapes, trailing tokens and non-JSON
+// numbers are refused. Unknown host-audit fields are parsed but never interpreted as paths.
+struct Json {
+    enum Kind { Object, Array, String, Number, Boolean, Null } kind = Null;
+    std::string text;
+    std::map<std::string, Json> members;
+};
+class JsonReader {
+    std::string_view text_;
+    size_t at_ = 0, nodes_ = 0;
+    void Space() { while (at_ < text_.size() && (text_[at_] == ' ' || text_[at_] == '\n' || text_[at_] == '\r' || text_[at_] == '\t')) ++at_; }
+    char Take() { if (at_ == text_.size()) Invalid("Truncated manifest JSON"); return text_[at_++]; }
+    void Want(char c) { Space(); if (Take() != c) Invalid("Malformed manifest JSON"); }
+    uint32_t Hex4() {
+        uint32_t value = 0;
+        for (int i = 0; i != 4; ++i) {
+            char c = Take();
+            int n = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+            if (n < 0) Invalid("Invalid JSON unicode escape");
+            value = value * 16 + n;
+        }
+        return value;
+    }
+    static void Utf8(std::string& out, uint32_t c) {
+        if (c < 0x80) out += char(c);
+        else if (c < 0x800) { out += char(0xc0 | (c >> 6)); out += char(0x80 | (c & 63)); }
+        else if (c < 0x10000) { out += char(0xe0 | (c >> 12)); out += char(0x80 | ((c >> 6) & 63)); out += char(0x80 | (c & 63)); }
+        else { out += char(0xf0 | (c >> 18)); out += char(0x80 | ((c >> 12) & 63)); out += char(0x80 | ((c >> 6) & 63)); out += char(0x80 | (c & 63)); }
+    }
+    std::string String() {
+        Want('"'); std::string out;
+        for (;;) {
+            auto c = static_cast<unsigned char>(Take());
+            if (c == '"') return out;
+            if (c < 0x20) Invalid("Control byte in JSON string");
+            if (c == '\\') {
+                char escape = Take();
+                switch (escape) {
+                    case '"': case '\\': case '/': out += escape; break;
+                    case 'b': out += '\b'; break; case 'f': out += '\f'; break;
+                    case 'n': out += '\n'; break; case 'r': out += '\r'; break; case 't': out += '\t'; break;
+                    case 'u': {
+                        uint32_t code = Hex4();
+                        if (code >= 0xd800 && code <= 0xdbff) {
+                            if (Take() != '\\' || Take() != 'u') Invalid("Unpaired JSON surrogate");
+                            uint32_t low = Hex4();
+                            if (low < 0xdc00 || low > 0xdfff) Invalid("Unpaired JSON surrogate");
+                            code = 0x10000 + ((code - 0xd800) << 10) + low - 0xdc00;
+                        } else if (code >= 0xdc00 && code <= 0xdfff) Invalid("Unpaired JSON surrogate");
+                        Utf8(out, code); break;
+                    }
+                    default: Invalid("Invalid JSON string escape");
+                }
+            } else if (c < 0x80) out += char(c);
+            else {
+                int count = c >= 0xc2 && c <= 0xdf ? 1 : c >= 0xe0 && c <= 0xef ? 2 : c >= 0xf0 && c <= 0xf4 ? 3 : -1;
+                if (count < 0) Invalid("Invalid UTF-8 in manifest");
+                uint32_t code = c & ((1 << (6 - count)) - 1);
+                for (int i = 0; i < count; ++i) {
+                    unsigned char tail = Take();
+                    if ((tail & 0xc0) != 0x80) Invalid("Invalid UTF-8 in manifest");
+                    code = (code << 6) | (tail & 63);
+                }
+                if (code < (count == 1 ? 0x80u : count == 2 ? 0x800u : 0x10000u) || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) Invalid("Invalid UTF-8 in manifest");
+                Utf8(out, code);
+            }
+        }
+    }
+    Json Read(unsigned depth) {
+        if (depth > 32 || ++nodes_ > 16384) Invalid("Manifest JSON exceeds structural limits");
+        Space(); if (at_ == text_.size()) Invalid("Truncated manifest JSON");
+        Json value;
+        char c = text_[at_];
+        if (c == '"') { value.kind = Json::String; value.text = String(); return value; }
+        if (c == '{' || c == '[') {
+            value.kind = c == '{' ? Json::Object : Json::Array;
+            char end = c == '{' ? '}' : ']'; ++at_; Space();
+            if (at_ < text_.size() && text_[at_] == end) { ++at_; return value; }
+            for (;;) {
+                std::string key;
+                if (c == '{') { key = String(); Want(':'); }
+                Json child = Read(depth + 1);
+                if (c == '{' && !value.members.emplace(key, std::move(child)).second) Invalid("Duplicate manifest JSON key");
+                Space(); char next = Take();
+                if (next == end) return value;
+                if (next != ',') Invalid("Malformed manifest JSON container");
+            }
+        }
+        for (auto literal : {"true", "false", "null"}) {
+            if (text_.substr(at_, std::strlen(literal)) == literal) {
+                value.kind = literal[0] == 'n' ? Json::Null : Json::Boolean;
+                value.text = literal; at_ += value.text.size(); return value;
+            }
+        }
+        size_t start = at_;
+        if (text_[at_] == '-') ++at_;
+        auto digit = [&] { return at_ < text_.size() && text_[at_] >= '0' && text_[at_] <= '9'; };
+        if (!digit()) Invalid("Invalid manifest JSON number");
+        if (text_[at_] == '0') ++at_;
+        else while (digit()) ++at_;
+        if (at_ < text_.size() && text_[at_] == '.') { ++at_; if (!digit()) Invalid("Invalid JSON fraction"); while (digit()) ++at_; }
+        if (at_ < text_.size() && (text_[at_] == 'e' || text_[at_] == 'E')) {
+            ++at_; if (at_ < text_.size() && (text_[at_] == '+' || text_[at_] == '-')) ++at_;
+            if (!digit()) Invalid("Invalid JSON exponent"); while (digit()) ++at_;
+        }
+        value.kind = Json::Number; value.text = text_.substr(start, at_ - start); return value;
+    }
+public:
+    explicit JsonReader(std::string_view text) : text_(text) {}
+    Json Parse() { auto value = Read(0); Space(); if (at_ != text_.size()) Invalid("Trailing manifest JSON data"); return value; }
+};
+const Json& Member(const Json& object, const std::string& key, Json::Kind kind) {
+    auto it = object.members.find(key);
+    if (object.kind != Json::Object || it == object.members.end() || it->second.kind != kind) Invalid("Missing or invalid manifest field: " + key);
+    return it->second;
+}
+struct Stamp {
+    dev_t device; ino_t inode; off_t size; timespec modified, changed;
+    bool operator==(const Stamp& b) const {
+        return device == b.device && inode == b.inode && size == b.size && modified.tv_sec == b.modified.tv_sec && modified.tv_nsec == b.modified.tv_nsec && changed.tv_sec == b.changed.tv_sec && changed.tv_nsec == b.changed.tv_nsec;
+    }
+};
+Stamp Stat(const struct stat& s) { return {s.st_dev, s.st_ino, s.st_size, s.st_mtimespec, s.st_ctimespec}; }
+struct stat Fstat(int fd) { struct stat s{}; if (fstat(fd, &s)) Io("Inspect opened asset"); return s; }
+Fd OpenDirectory(int parent, const char* name) {
+    int fd = openat(parent, name, O_RDONLY | O_CLOEXEC | O_DIRECTORY | O_NOFOLLOW);
+    if (fd < 0) { if (errno == ELOOP || errno == ENOTDIR) Invalid("Installation path must be a real directory"); Io("Open installation directory"); }
+    return Fd(fd);
+}
+bool Exists(int parent, const char* name) {
+    struct stat s{};
+    if (!fstatat(parent, name, &s, AT_SYMLINK_NOFOLLOW)) return true;
+    if (errno == ENOENT) return false;
+    Io("Inspect installation path");
+}
+Fd OpenFile(int directory, const char* name, uint64_t maximum) {
+    int fd = openat(directory, name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) Invalid(std::string("Cannot read regular asset: ") + name);
+    Fd file(fd); auto s = Fstat(fd);
+    if (!S_ISREG(s.st_mode) || s.st_nlink != 1 || s.st_size < 0 || uint64_t(s.st_size) > maximum) Invalid(std::string("Unsafe or oversized asset: ") + name);
+    return file;
+}
+ssize_t Read(int fd, void* data, size_t count) {
+    ssize_t result;
+    do { result = read(fd, data, count); } while (result < 0 && errno == EINTR);
+    if (result < 0) Io("Read asset");
+    return result;
+}
+struct Verified {
+    Stamp directory;
+    std::map<std::string, Stamp> files;
+};
+void CheckUnchanged(int parent, const char* name, const Verified& verified) {
+    auto dir = OpenDirectory(parent, name);
+    if (!(Stat(Fstat(dir.value)) == verified.directory)) Invalid("Installation directory changed during verification");
+    for (const auto& [file, stamp] : verified.files) {
+        struct stat s{};
+        if (fstatat(dir.value, file.c_str(), &s, AT_SYMLINK_NOFOLLOW) || !S_ISREG(s.st_mode) || s.st_nlink != 1 || !(Stat(s) == stamp)) Invalid("Asset changed during verification: " + file);
+    }
+}
+Verified Verify(int directory, std::span<const AssetSpec> catalogue, const InstallCallbacks& cb, bool hash = true) {
+    CheckCancel(cb);
+    Verified verified{Stat(Fstat(directory)), {}};
+    std::map<std::string, const AssetSpec*> expected;
+    for (const auto& item : catalogue) expected.emplace(item.name, &item);
+    std::set<std::string> found;
+    Fd enumeration(openat(directory, ".", O_RDONLY | O_CLOEXEC | O_DIRECTORY));
+    if (enumeration.value < 0) Io("Open installation listing");
+    DIR* listing = fdopendir(enumeration.value);
+    if (!listing) Io("List installation");
+    enumeration.value = -1;
+    std::unique_ptr<DIR, decltype(&closedir)> closer(listing, closedir);
+    for (;;) {
+        errno = 0; auto* entry = readdir(listing);
+        if (!entry) { if (errno) Io("List installation"); break; }
+        std::string name(entry->d_name);
+        if (name == "." || name == "..") continue;
+        if (!expected.contains(name) && name != manifest_name && name != "source.txt") Invalid("Unexpected file in asset installation: " + name);
+        found.insert(name);
+    }
+    auto manifest = OpenFile(directory, manifest_name, max_manifest);
+    auto manifest_stamp = Stat(Fstat(manifest.value));
+    std::string bytes(static_cast<size_t>(manifest_stamp.size), '\0');
+    size_t offset = 0;
+    while (offset != bytes.size()) { auto n = Read(manifest.value, bytes.data() + offset, bytes.size() - offset); if (!n) Invalid("Truncated installation manifest"); offset += n; }
+    if (!(Stat(Fstat(manifest.value)) == manifest_stamp)) Invalid("Manifest changed while reading");
+    verified.files.emplace(manifest_name, manifest_stamp);
+    auto json = JsonReader(bytes).Parse();
+    if (Member(json, "schema", Json::String).text != "pt-ipad-assets-v1") Invalid("Unsupported installation manifest schema");
+    const auto& assets = Member(json, "assets", Json::Object);
+    for (const auto& [name, value] : assets.members) if (!expected.contains(name)) Invalid("Unknown or unsafe manifest asset name");
+    std::vector<unsigned char> buffer(256 * 1024);
+    for (const auto& asset : catalogue) {
+        std::string name(asset.name);
+        bool listed = assets.members.contains(name), present = found.contains(name);
+        if (!listed && !present && !asset.required) continue;
+        if (!listed || !present) Invalid("Missing asset or manifest entry: " + name);
+        const auto& record = Member(assets, name, Json::Object);
+        const auto& size = Member(record, "bytes", Json::Number).text;
+        uint64_t length = 0;
+        auto number = std::from_chars(size.data(), size.data() + size.size(), length);
+        if (number.ec != std::errc() || number.ptr != size.data() + size.size() || length != asset.bytes || Member(record, "sha256", Json::String).text != asset.sha256) Invalid("Manifest does not match the compiled asset catalogue: " + name);
+        auto file = OpenFile(directory, name.c_str(), asset.bytes);
+        auto before = Fstat(file.value);
+        if (uint64_t(before.st_size) != asset.bytes) Invalid("Incorrect asset length: " + name);
+        if (hash) {
+            CC_SHA256_CTX context; CC_SHA256_Init(&context);
+            uint64_t done = 0;
+            Progress(cb, InstallPhase::Verifying, name, done, asset.bytes);
+            for (;;) {
+                CheckCancel(cb);
+                auto count = Read(file.value, buffer.data(), buffer.size());
+                if (!count) break;
+                done += count;
+                if (done > asset.bytes) Invalid("Asset grew while hashing: " + name);
+                CC_SHA256_Update(&context, buffer.data(), static_cast<CC_LONG>(count));
+                Progress(cb, InstallPhase::Verifying, name, done, asset.bytes);
+            }
+            std::array<unsigned char, CC_SHA256_DIGEST_LENGTH> digest{};
+            CC_SHA256_Final(digest.data(), &context);
+            static constexpr char hex[] = "0123456789abcdef";
+            std::string text;
+            for (auto byte : digest) { text += hex[byte >> 4]; text += hex[byte & 15]; }
+            if (done != asset.bytes || text != asset.sha256) Invalid("SHA-256 mismatch: " + name);
+        }
+        if (!(Stat(before) == Stat(Fstat(file.value)))) Invalid("Asset changed while hashing: " + name);
+        verified.files.emplace(name, Stat(before));
+    }
+    if (found.contains("source.txt")) {
+        auto source = OpenFile(directory, "source.txt", 65536);
+        verified.files.emplace("source.txt", Stat(Fstat(source.value)));
+    }
+    if (!(Stat(Fstat(directory)) == verified.directory)) Invalid("Installation directory changed during verification");
+    return verified;
+}
+InstallResult Error(const Failure& failure) { return {failure.status, {}, failure.message}; }
+#endif
+} // namespace
+
+std::span<const AssetSpec> KnownUsAssets() { return known; }
+InstallResult PrepareUsInstallation(const std::filesystem::path& documents, const InstallCallbacks& callbacks) {
+    return PrepareInstallation(documents, KnownUsAssets(), callbacks);
+}
+InstallResult VerifyInstallation(const std::filesystem::path& directory, std::span<const AssetSpec> catalogue, const InstallCallbacks& callbacks) {
+#if defined(__APPLE__)
+    try {
+        ValidateCatalogue(catalogue);
+        auto parent = OpenDirectory(AT_FDCWD, directory.parent_path().c_str());
+        auto dir = OpenDirectory(parent.value, directory.filename().c_str());
+        auto verified = Verify(dir.value, catalogue, callbacks);
+        CheckUnchanged(parent.value, directory.filename().c_str(), verified);
+        return {InstallStatus::Ready, directory, "Installation hashes verified"};
+    } catch (const Failure& failure) { return Error(failure); }
+    catch (const std::exception&) { return {InstallStatus::IoError, {}, "Installation verification failed"}; }
+#else
+    return {InstallStatus::Unsupported, {}, "Native installation verification requires Apple APIs"};
+#endif
+}
+InstallResult PrepareInstallation(const std::filesystem::path& documents, std::span<const AssetSpec> catalogue, const InstallCallbacks& callbacks) {
+#if defined(__APPLE__)
+    try {
+        ValidateCatalogue(catalogue);
+        // Resolve only the trusted OS-provided Documents root (iOS /var is a system
+        // symlink). All installation children are opened relative to its descriptor.
+        auto root = OpenDirectory(AT_FDCWD, documents.c_str());
+        Fd lock(openat(root.value, ".pt-assets.lock", O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK, 0600));
+        if (lock.value < 0) Io("Open installation lock");
+        auto lock_stat = Fstat(lock.value);
+        if (!S_ISREG(lock_stat.st_mode) || lock_stat.st_nlink != 1) Invalid("Invalid installation lock file");
+        if (flock(lock.value, LOCK_EX | LOCK_NB)) {
+            if (errno == EWOULDBLOCK) return {InstallStatus::Busy, {}, "Another installation operation is in progress"};
+            Io("Lock installation");
+        }
+        CheckCancel(callbacks);
+        bool current = Exists(root.value, current_name), incoming = Exists(root.value, incoming_name);
+        if (!incoming) {
+            if (!current) return {InstallStatus::Missing, {}, "Copy a verified installation to CUSA01127.incoming in Documents"};
+            auto dir = OpenDirectory(root.value, current_name);
+            auto verified = Verify(dir.value, catalogue, callbacks);
+            CheckUnchanged(root.value, current_name, verified);
+            return {InstallStatus::Ready, documents / current_name, "Installation hashes verified"};
+        }
+        Verified staged{};
+        try {
+            auto dir = OpenDirectory(root.value, incoming_name);
+            staged = Verify(dir.value, catalogue, callbacks);
+            CheckUnchanged(root.value, incoming_name, staged);
+        } catch (const Failure& rejected) {
+            if (rejected.status != InstallStatus::Invalid || !current) throw;
+            auto dir = OpenDirectory(root.value, current_name);
+            auto existing = Verify(dir.value, catalogue, callbacks);
+            CheckUnchanged(root.value, current_name, existing);
+            return {InstallStatus::Ready, documents / current_name, "Incoming installation rejected: " + rejected.message, true};
+        }
+        Verified existing{};
+        if (current) {
+            if (Exists(root.value, previous_name)) return {InstallStatus::Busy, {}, "Prior installation backup exists; preserve or remove it before replacement"};
+            auto dir = OpenDirectory(root.value, current_name);
+            // Check ownership/shape before replacement. A damaged owned install may
+            // be repaired, but an unrelated directory or save file is never displaced.
+            existing = Verify(dir.value, catalogue, callbacks, false);
+        }
+        Progress(callbacks, InstallPhase::BeforeActivation);
+        CheckUnchanged(root.value, incoming_name, staged);
+        if (current) CheckUnchanged(root.value, current_name, existing);
+        CheckCancel(callbacks);
+        unsigned flags = current ? RENAME_SWAP : RENAME_EXCL;
+        if (renameatx_np(root.value, incoming_name, root.value, current_name, flags)) Io("Atomically activate installation");
+        try {
+            Progress(callbacks, InstallPhase::AfterExchange);
+            if (current && renameatx_np(root.value, incoming_name, root.value, previous_name, RENAME_EXCL)) Io("Retain previous installation");
+        } catch (...) {
+            // No cancellation points inside rollback: restore the original names in
+            // one filesystem operation even when a callback itself threw.
+            int rollback = current ? renameatx_np(root.value, incoming_name, root.value, current_name, RENAME_SWAP)
+                                   : renameatx_np(root.value, current_name, root.value, incoming_name, RENAME_EXCL);
+            if (rollback) throw Failure{InstallStatus::IoError, "Activation rollback failed; directories retained for recovery"};
+            throw;
+        }
+        // Commit has completed. Late cancellation belongs to the next operation.
+        // The previous directory is intentionally retained; no recursive deletion.
+        fsync(root.value);
+        return {InstallStatus::Activated, documents / current_name, current ? "Installation activated; prior assets retained in CUSA01127.previous" : "Installation activated"};
+    } catch (const Failure& failure) { return Error(failure); }
+    catch (const std::exception&) { return {InstallStatus::IoError, {}, "Installation failed; inspect retained directories before retrying"}; }
+#else
+    return {InstallStatus::Unsupported, {}, "Native installation activation requires Apple APIs"};
+#endif
+}
+} // namespace pt::assets
