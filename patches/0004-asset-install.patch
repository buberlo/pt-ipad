+            Write(t.root / "CUSA01127/import-manifest.json", escaped);
+            Expect(PrepareInstallation(t.root, fixture).ready(), "valid JSON unicode escape rejected");
+        });
+        Test("wrong length and missing required file", [] {
+            Temp t; Assets(t.root / "CUSA01127");
