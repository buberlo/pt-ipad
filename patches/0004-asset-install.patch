+            std::vector<std::string> bad = {"", "[]", "{}", valid + "x", "{\"schema\":\"pt-ipad-assets-v1\",\"schema\":\"pt-ipad-assets-v1\",\"assets\":{}}", std::string(1024 * 1024 + 1, ' ')};
+            for (auto [before, after] : std::array<std::pair<const char*, const char*>, 13>{{
+                {"pt-ipad-assets-v1", "other-schema"}, {"\"bytes\":3", "\"bytes\":-3"},
+                {"\"bytes\":3", "\"bytes\":3.0"}, {"\"bytes\":3", "\"bytes\":3e0"},
+                {"\"bytes\":3", "\"bytes\":03"}, {"\"bytes\":3", "\"bytes\":18446744073709551616"},
+                {"chunk1.psarc", "../chunk1.psarc"}, {"chunk1.psarc", "C:\\\\chunk1.psarc"},
+                {"chunk1.psarc", "chunk1.psarc\\u0000tail"}, {"chunk1.psarc", "\\q"},
+                {"chunk1.psarc", "\\ud800"}, {"chunk1.psarc", "\\udc00"},
+                {"ba7816bf", "BA7816BF"}
+            }}) { auto malformed = valid; Replace(malformed, before, after); bad.push_back(malformed); }
+            for (const auto& malformed : bad) {
