new file mode 100644
index 0000000..b78ccc2
--- /dev/null
+++ b/src/engine/platform/profiling_csv.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <cstdio>
+#include <array>
+namespace pt {
+// Diagnostic only: bounded memory, recoverable rows after external termination.
+class ProfilingCsv {
+public:
+    ProfilingCsv(const char* path, const char* header) : file_(std::fopen(path, "w")) {
+        if (file_) {
+            std::setvbuf(file_, buffer_.data(), _IOFBF, buffer_.size());
+            std::fputs(header, file_);
+            std::fflush(file_);
+        }
+    }
+    ~ProfilingCsv() { if (file_) std::fclose(file_); }
+    ProfilingCsv(const ProfilingCsv&) = delete;
+    ProfilingCsv& operator=(const ProfilingCsv&) = delete;
+    template<class... Args> void Write(const char* format, Args... args) {
+        if (!file_) return;
+        std::fprintf(file_, format, args...);
+        if (++rows_ % 60 == 0) std::fflush(file_);
+    }
+private:
+    FILE* file_ = nullptr;
+    std::array<char, 65536> buffer_{};
+    unsigned long long rows_ = 0;
+};
+}
