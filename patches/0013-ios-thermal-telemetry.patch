diff --git a/src/engine/platform/apple_host.h b/src/engine/platform/apple_host.h
--- a/src/engine/platform/apple_host.h
+++ b/src/engine/platform/apple_host.h
@@ -5,6 +5,10 @@
 #endif
 // iOS foreground state, including system permission dialogs that remove focus.
 bool pt_apple_is_active(void);
+// OS-reported thermal pressure, not a temperature measurement. Static string.
+const char* pt_apple_thermal_state(void);
+// 1=enabled, 0=disabled, -1=unavailable. Never infer "off" from missing data.
+int pt_apple_low_power_mode(void);
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/engine/platform/apple_host.m b/src/engine/platform/apple_host.m
--- a/src/engine/platform/apple_host.m
+++ b/src/engine/platform/apple_host.m
@@ -14,6 +14,26 @@
     });
     return active;
 }
+
+const char* pt_apple_thermal_state(void) {
+    if (@available(iOS 11.0, *)) {
+        switch ([NSProcessInfo processInfo].thermalState) {
+            case NSProcessInfoThermalStateNominal: return "nominal";
+            case NSProcessInfoThermalStateFair: return "fair";
+            case NSProcessInfoThermalStateSerious: return "serious";
+            case NSProcessInfoThermalStateCritical: return "critical";
+            default: return "unknown";
+        }
+    }
+    return "unavailable";
+}
+
+int pt_apple_low_power_mode(void) {
+    if (@available(iOS 9.0, *)) return [NSProcessInfo processInfo].lowPowerModeEnabled ? 1 : 0;
+    return -1;
+}
 #else
 bool pt_apple_is_active(void) { return true; }
+const char* pt_apple_thermal_state(void) { return "unavailable"; }
+int pt_apple_low_power_mode(void) { return -1; }
 #endif
