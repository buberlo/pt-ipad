@@ -0,0 +1,10 @@
+#ifndef PT_TEXTURE_BINDINGS_GLSL
+#define PT_TEXTURE_BINDINGS_GLSL
+#extension GL_EXT_nonuniform_qualifier : require
+layout(set = 0, binding = 0) uniform texture2D textures[];
+layout(set = 0, binding = 2) uniform textureCube cube_textures[];
+layout(set = 0, binding = 3) uniform sampler texture_sampler;
+layout(set = 0, binding = 4) uniform sampler cube_sampler;
+#define PT_TEXTURE(index) sampler2D(textures[nonuniformEXT(index)], texture_sampler)
+#define PT_CUBE(index) samplerCube(cube_textures[nonuniformEXT(index)], cube_sampler)
+#endif
