index 0000000..c711f50
--- /dev/null
+++ b/tests/descriptor_budget_test.cpp
@@ -0,0 +1,25 @@
+#include "engine/render/descriptor_budget.h"
+#include <cassert>
+#include <cstdio>
+int main() {
+    VkPhysicalDeviceVulkan12Properties p{};
+    p.maxPerStageDescriptorUpdateAfterBindSampledImages = 1000000;
+    p.maxDescriptorSetUpdateAfterBindSampledImages = 1000000;
+    p.maxPerStageUpdateAfterBindResources = 1000000;
+    p.maxUpdateAfterBindDescriptorsInAllPools = 1000000;
+    p.maxPerStageDescriptorUpdateAfterBindSamplers = 1024;
+    p.maxDescriptorSetUpdateAfterBindSamplers = 1024;
+    assert(pt::TextureDescriptorCapacity(p, 8192, 64) == 8192); // 8K textures no longer need 8K samplers.
+    assert(pt::TextureDescriptorCapacity(p, 8192, 64, 1024) == 956);
+    assert(pt::TextureDescriptorCapacity(p, 8192, 64, 2) == 0);
+    p.maxPerStageDescriptorUpdateAfterBindSampledImages = 1024;
+    assert(pt::TextureDescriptorCapacity(p, 8192, 64) == 832);
+    p.maxPerStageDescriptorUpdateAfterBindSampledImages = 128;
+    assert(pt::TextureDescriptorCapacity(p, 8192, 64) == 0); // no unsigned wraparound
+    p.maxPerStageDescriptorUpdateAfterBindSampledImages = 1000000;
+    p.maxUpdateAfterBindDescriptorsInAllPools = 400;
+    assert(pt::TextureDescriptorCapacity(p, 8192, 64) == 208);
+    p.maxPerStageDescriptorUpdateAfterBindSamplers = 16;
+    assert(pt::TextureDescriptorCapacity(p, 8192, 64) == 0);
+    std::puts("descriptor budget: 7 cases passed");
+}
