diff --git a/src/engine/render/descriptor_budget.h b/src/engine/render/descriptor_budget.h
new file mode 100644
index 0000000..aa74d87
--- /dev/null
+++ b/src/engine/render/descriptor_budget.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vulkan/vulkan.h>
+
+namespace pt {
+// Frame/post sets use 57 sampled images; reserve 128 for these and optional passes.
+// Samplers are shared descriptors, not duplicated for every texture in the array.
+inline uint32_t TextureDescriptorCapacity(const VkPhysicalDeviceVulkan12Properties& p, uint32_t wanted, uint32_t cubes, uint32_t per_set = UINT32_MAX) {
+    constexpr uint32_t reserve = 128;
+    const uint32_t images = std::min({p.maxPerStageDescriptorUpdateAfterBindSampledImages,
+                                     p.maxDescriptorSetUpdateAfterBindSampledImages,
+                                     p.maxPerStageUpdateAfterBindResources,
+                                     p.maxUpdateAfterBindDescriptorsInAllPools});
+    if (images <= reserve || cubes > images - reserve ||
+        p.maxPerStageDescriptorUpdateAfterBindSamplers < 32 || p.maxDescriptorSetUpdateAfterBindSamplers < 32) return 0;
+    // One material SSBO and two sampler descriptors. Keep one descriptor spare for
+    // MoltenVK versions whose layout-support query treats maxPerSetDescriptors as exclusive.
+    if (per_set <= 4 || cubes > per_set - 4) return 0;
+    return std::min({wanted, images - reserve - cubes, per_set - cubes - 4});
+}
+}
