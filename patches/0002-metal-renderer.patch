+        if (result != VK_SUCCESS && result != VK_INCOMPLETE) { display_fps_ = -1.0; return; }
+        past.resize(count);
+        std::sort(past.begin(), past.end(), [](const auto& a, const auto& b) { return a.presentID < b.presentID; });
+    }
+    for (const auto& item : past) {
+        if (!item.actualPresentTime || item.presentID <= last_present_id_) continue;
+        if ((last_present_id_ && item.presentID != last_present_id_ + 1) ||
+            (!display_times_.empty() && item.actualPresentTime <= display_times_.back())) display_times_.clear();
+        last_present_id_ = item.presentID;
+        if (display_times_.size() == 256) display_times_.erase(display_times_.begin());
+        display_times_.push_back(item.actualPresentTime);
+        ++displayed_frames_;
+        display_arrival_ns_ = now;
+    }
+    display_fps_ = -1.0;
+    if (display_times_.size() > 1 && now - display_arrival_ns_ < 1500000000) {
+        const uint64_t elapsed = display_times_.back() - display_times_.front();
+        if (elapsed >= 500000000) display_fps_ = (display_times_.size() - 1) * 1.0e9 / static_cast<double>(elapsed);
+    }
+    if (!display_log_ns_ || now - display_log_ns_ >= 1000000000) {
