+        existing_timing |= item->sType == VK_STRUCTURE_TYPE_PRESENT_TIMES_INFO_GOOGLE;
+    if (display_timing_ && !existing_timing && info.swapchainCount == 1 && info.pSwapchains[0] == swapchain.handle) {
+        if (!next_present_id_) { next_present_id_ = 1; ResetDisplayTiming(); time.presentID = 1; }
+        timing.pNext = info.pNext; timing.swapchainCount = 1; timing.pTimes = &time;
+        timed.pNext = &timing;
