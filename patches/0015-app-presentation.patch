diff --git a/cmake/MergeIconInfo.cmake b/cmake/MergeIconInfo.cmake
new file mode 100644
index 0000000..d73333f
--- /dev/null
+++ b/cmake/MergeIconInfo.cmake
@@ -0,0 +1,14 @@
+# actool owns icon filenames and metadata. Merge its actual output after CMake's
+# bundle plist generation; deleting previous icon keys makes incremental builds safe.
+if(NOT EXISTS "${ICON_INFO}" OR NOT EXISTS "${APP_INFO}")
+  message(FATAL_ERROR "Missing compiled icon metadata or application plist")
+endif()
+foreach(key CFBundleIcons "CFBundleIcons~ipad")
+  execute_process(COMMAND /usr/libexec/PlistBuddy -c "Delete :${key}" "${APP_INFO}"
+    OUTPUT_QUIET ERROR_QUIET)
+endforeach()
+execute_process(COMMAND /usr/libexec/PlistBuddy -c "Merge '${ICON_INFO}'" "${APP_INFO}"
+  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
+if(NOT result EQUAL 0)
+  message(FATAL_ERROR "Could not merge icon metadata: ${output} ${error}")
+endif()
