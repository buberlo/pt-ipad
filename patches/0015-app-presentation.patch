diff --git a/assets/apple/Assets.xcassets/Contents.json b/assets/apple/Assets.xcassets/Contents.json
new file mode 100644
index 0000000..b26b56f
--- /dev/null
+++ b/assets/apple/Assets.xcassets/Contents.json
@@ -0,0 +1 @@
+{"info":{"author":"PT-iPad","version":1}}
diff --git a/cmake/AppleBundle.cmake b/cmake/AppleBundle.cmake
index 0d58d67..bf79869 100644
--- a/cmake/AppleBundle.cmake
+++ b/cmake/AppleBundle.cmake
@@ -1,12 +1,26 @@
-set(PT_APP_BUILD "3" CACHE STRING "Native application build number")
+set(PT_APP_BUILD "5" CACHE STRING "Native application build number")
 if(NOT PT_APP_BUILD MATCHES "^[1-9][0-9]*$")
   message(FATAL_ERROR "PT_APP_BUILD must be a positive integer")
 endif()
+if(PT_IOS)
+  find_program(PT_XCRUN xcrun REQUIRED NO_CMAKE_FIND_ROOT_PATH)
+  set(PT_ICON_SOURCE "${CMAKE_SOURCE_DIR}/assets/apple/Assets.xcassets")
+  set(PT_ICON_OUTPUT "${CMAKE_BINARY_DIR}/app-icons")
+  set(PT_ICON_INFO "${CMAKE_BINARY_DIR}/app-icon-info.plist")
+  file(GLOB_RECURSE PT_ICON_INPUTS CONFIGURE_DEPENDS "${PT_ICON_SOURCE}/*")
+  add_custom_command(OUTPUT "${PT_ICON_OUTPUT}/Assets.car" "${PT_ICON_INFO}"
+    COMMAND ${CMAKE_COMMAND} -E make_directory "${PT_ICON_OUTPUT}"
+    COMMAND "${PT_XCRUN}" actool "${PT_ICON_SOURCE}" --compile "${PT_ICON_OUTPUT}"
+      --platform iphoneos --minimum-deployment-target "${CMAKE_OSX_DEPLOYMENT_TARGET}"
+      --target-device ipad --app-icon AppIcon --output-partial-info-plist "${PT_ICON_INFO}"
+    DEPENDS ${PT_ICON_INPUTS} VERBATIM)
+  add_custom_target(pt_app_icons DEPENDS "${PT_ICON_OUTPUT}/Assets.car" "${PT_ICON_INFO}")
+endif()
 foreach(game pt pt_release)
   target_compile_definitions(${game} PRIVATE PT_NATIVE_BUILD="${PT_APP_BUILD}")
   set_target_properties(${game} PROPERTIES MACOSX_BUNDLE TRUE
     MACOSX_BUNDLE_GUI_IDENTIFIER "${PT_BUNDLE_IDENTIFIER}"
-    MACOSX_BUNDLE_BUNDLE_NAME "P.T. Native"
+    MACOSX_BUNDLE_BUNDLE_NAME "P.T."
     MACOSX_BUNDLE_SHORT_VERSION_STRING "${PT_VERSION}"
     MACOSX_BUNDLE_BUNDLE_VERSION "${PT_APP_BUILD}"
     MACOSX_BUNDLE_INFO_PLIST "${CMAKE_SOURCE_DIR}/cmake/Info.plist.in"
@@ -19,6 +33,13 @@ foreach(game pt pt_release)
     set(resources "$<TARGET_BUNDLE_CONTENT_DIR:${game}>/Resources")
   endif()
   add_dependencies(${game} pt_shaders)
+  if(PT_IOS)
+    add_dependencies(${game} pt_app_icons)
+    add_custom_command(TARGET ${game} POST_BUILD
+      COMMAND ${CMAKE_COMMAND} -E copy_directory "${PT_ICON_OUTPUT}" "${resources}"
+      COMMAND ${CMAKE_COMMAND} "-DICON_INFO=${PT_ICON_INFO}" "-DAPP_INFO=${resources}/Info.plist"
+        -P "${CMAKE_SOURCE_DIR}/cmake/MergeIconInfo.cmake" VERBATIM)
+  endif()
   add_custom_command(TARGET ${game} POST_BUILD
     COMMAND ${CMAKE_COMMAND} -E copy_directory "${PT_SPIRV_DIR}" "${resources}/shaders"
     COMMAND ${CMAKE_COMMAND} -E copy_directory "${PT_VOICE_DIR}" "${resources}/voice"
diff --git a/cmake/Info.plist.in b/cmake/Info.plist.in
