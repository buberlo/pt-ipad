diff --git a/src/engine/platform/touch_controls.h b/src/engine/platform/touch_controls.h
new file mode 100644
index 0000000..978c15e
--- /dev/null
+++ b/src/engine/platform/touch_controls.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace pt {
+
+// Normalized coordinates keep the interaction model independent of SDL and pixel density.
+// Each finger owns its original control until release; sliding cannot press a second button.
+class TouchControls {
+public:
+    enum class Control { None, Move, Look, Interact, Zoom, Pause, Back };
+    struct Button { Control control; float x, y, radius; const char* label; };
+    static constexpr std::array<Button, 4> buttons{{
+        {Control::Interact, .90f, .72f, .065f, "Interact"},
+        {Control::Zoom, .77f, .85f, .060f, "Zoom"},
+        {Control::Pause, .92f, .10f, .045f, "Pause"},
+        {Control::Back, .77f, .10f, .045f, "Back"},
+    }};
+    struct State {
+        float move_x = 0, move_y = 0, look_x = 0, look_y = 0;
+        bool interact = false, zoom = false, interact_pressed = false;
+        bool pause = false, back = false, any = false;
+    };
+
+    void Down(uint64_t id, float x, float y) {
+        if (!Finite(x, y) || Find(id)) return;
+        auto slot = std::find_if(fingers_.begin(), fingers_.end(), [](const Finger& f) { return !f.used; });
+        if (slot == fingers_.end()) return;
+        Control control = Control::None;
+        for (const auto& b : buttons) {
+            if (std::hypot((x - b.x) * aspect_, y - b.y) <= b.radius) {
+                control = b.control;
+                break;
+            }
+        }
+        if (control == Control::None) control = x < .45f ? Control::Move : Control::Look;
+        if (std::any_of(fingers_.begin(), fingers_.end(), [control](const Finger& f) { return f.used && f.control == control; })) return;
+        *slot = {true, id, control, x, y, x, y};
+        edges_.any = true;
+        edges_.interact_pressed |= control == Control::Interact;
+        edges_.pause |= control == Control::Pause;
+        edges_.back |= control == Control::Back;
+    }
+    void Motion(uint64_t id, float x, float y) {
+        Finger* f = Find(id);
+        if (!f || !Finite(x, y)) return;
+        if (f->control == Control::Look) {
+            edges_.look_x += (x - f->x) * aspect_;
+            edges_.look_y += y - f->y;
+        }
+        f->x = x; f->y = y;
+    }
+    void Up(uint64_t id) { if (auto* f = Find(id)) *f = {}; }
+    void Reset() { fingers_ = {}; edges_ = {}; }
+    void SetAspect(float aspect) { if (std::isfinite(aspect) && aspect > 0) aspect_ = aspect; }
+    State Poll() {
+        State result = edges_;
+        edges_ = {};
+        for (const auto& f : fingers_) {
+            if (!f.used) continue;
+            if (f.control == Control::Move) {
+                float x = (f.x - f.start_x) * aspect_ / .13f;
+                float y = (f.start_y - f.y) / .13f;
+                const float length = std::hypot(x, y);
+                if (length > .12f) {
+                    const float scale = std::min(1.f, (length - .12f) / .88f) / length;
+                    result.move_x = x * scale; result.move_y = y * scale;
+                }
+            }
+            result.interact |= f.control == Control::Interact;
+            result.zoom |= f.control == Control::Zoom;
+        }
+        return result;
+    }
+private:
+    struct Finger {
+        bool used = false; uint64_t id = 0; Control control = Control::None;
+        float start_x = 0, start_y = 0, x = 0, y = 0;
+    };
+    static bool Finite(float x, float y) { return std::isfinite(x) && std::isfinite(y); }
+    Finger* Find(uint64_t id) {
+        for (auto& f : fingers_) if (f.used && f.id == id) return &f;
+        return nullptr;
+    }
+    std::array<Finger, 10> fingers_{};
+    State edges_{};
+    float aspect_ = 16.f / 9.f;
+};
+}
