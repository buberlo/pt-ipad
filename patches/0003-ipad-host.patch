+    finger(SDL_EVENT_FINGER_DOWN, .90f, .72f);
+    finger(SDL_EVENT_FINGER_UP, .90f, .72f);
+    auto state = input.Poll(false, pt::MouseUse::Menu);
+    auto menu = pt::game::MapMenuInput(state, 0);
+    expect(menu.accept && menu.open_pc, "touch opens settings through controller action");
+    expect(!menu.toggle_vertical && !menu.toggle_horizontal, "interact does not change camera inversion");
+    expect(state.gouge_pressed, "interact supplies original cross-button gouge action");
+    input.Poll(false, pt::MouseUse::Menu);
+    finger(SDL_EVENT_FINGER_DOWN, .77f, .10f);
+    finger(SDL_EVENT_FINGER_UP, .77f, .10f);
+    menu = pt::game::MapMenuInput(input.Poll(false, pt::MouseUse::Menu), 0);
+    expect(menu.back && !menu.toggle_horizontal, "back does not change camera inversion");
+    finger(SDL_EVENT_FINGER_DOWN, .90f, .72f);
+    SDL_Event background{}; background.type = SDL_EVENT_WILL_ENTER_BACKGROUND;
+    input.ProcessEvent(background);
+    state = input.Poll(false, pt::MouseUse::Look);
+    expect(state.raw_held == 0 && state.raw_pressed == 0 && !state.any_button, "background cancels touch edges and holds");
+    input.EnableTouch(false);
+    finger(SDL_EVENT_FINGER_DOWN, .90f, .72f);
+    state = input.Poll(false, pt::MouseUse::Look);
+    expect(state.raw_held == 0 && !state.any_button, "disabled touch does not affect desktop input");
+    SDL_Quit();
+    return failed ? 1 : 0;
+}
